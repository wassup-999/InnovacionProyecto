.screen { flex-grow: 1; align-items: center; justify-content: center; background-color: rgb(14, 11, 9); }
.backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: url("Textures/MuseumBackdrop.png"); -unity-background-scale-mode: stretch-to-fill; }
.veil { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(8, 6, 4, 0.63); }
.frame { flex-grow: 1; width: 100%; padding: 36px 6% 26px 6%; justify-content: space-between; align-items: center; }
.top-bar { width: 100%; max-width: 1420px; flex-direction: row; align-items: center; padding-bottom: 13px; border-bottom-width: 1px; border-bottom-color: rgba(200, 162, 74, 0.52); }
.gold-square { width: 8px; height: 8px; background-color: rgb(200, 162, 74); margin-right: 14px; }
.museum-label { font-size: 12px; letter-spacing: 5px; color: rgb(222, 190, 121); -unity-font-style: bold; }
.top-line { flex-grow: 1; height: 1px; background-color: rgba(200, 162, 74, 0.25); margin-left: 18px; margin-right: 18px; }
.room-label { font-size: 10px; letter-spacing: 4px; color: rgba(233, 220, 195, 0.68); }
.content-row { flex-direction: row; align-items: center; justify-content: center; width: 100%; max-width: 1220px; flex-grow: 1; }
.intro { width: 68%; min-width: 560px; padding: 46px 60px 42px 60px; background-color: rgba(24, 20, 16, 0.91); border-left-width: 2px; border-left-color: rgb(200, 162, 74); }
.eyebrow { font-size: 11px; letter-spacing: 5px; color: rgb(200, 162, 74); margin-bottom: 18px; }
.title { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 58px; letter-spacing: 2px; color: rgb(246, 239, 223); -unity-text-align: middle-left; margin-bottom: -8px; }
.title-accent { color: rgb(227, 199, 122); }
.ornament { flex-direction: row; align-items: center; margin-top: 20px; margin-bottom: 22px; }
.ornament-small { margin-top: 10px; margin-bottom: 24px; }
.ornament-line { width: 72px; height: 1px; background-color: rgba(200, 162, 74, 0.6); }
.ornament-diamond { width: 7px; height: 7px; background-color: rgb(200, 162, 74); margin-left: 12px; margin-right: 12px; rotate: 45deg; }
.subtitle { max-width: 610px; font-size: 17px; color: rgba(233, 220, 195, 0.88); white-space: normal; }
.actions { margin-top: 30px; align-items: flex-start; }
.btn { width: 310px; height: 46px; margin-bottom: 9px; padding-left: 18px; padding-right: 18px; border-radius: 1px; letter-spacing: 2px; -unity-font-style: bold; -unity-text-align: middle-center; transition-property: background-color, border-color, color; transition-duration: 0.14s; }
.btn:focus { border-width: 2px; border-color: rgb(246, 239, 223); }
.btn-primary { background-color: rgb(200, 162, 74); border-width: 1px; border-color: rgb(227, 199, 122); color: rgb(26, 20, 15); }
.btn-primary:hover { background-color: rgb(219, 182, 96); border-color: rgb(246, 239, 223); }
.btn-primary:active { background-color: rgb(170, 134, 56); }
.btn-ghost { background-color: rgba(0, 0, 0, 0); border-width: 1px; border-color: rgba(200, 162, 74, 0.42); color: rgba(233, 220, 195, 0.84); }
.btn-ghost:hover { background-color: rgba(200, 162, 74, 0.13); border-color: rgba(227, 199, 122, 0.85); color: rgb(246, 239, 223); }
.side-note { flex-grow: 1; max-width: 320px; padding: 32px 28px; margin-left: 22px; border-top-width: 1px; border-bottom-width: 1px; border-color: rgba(200, 162, 74, 0.34); background-color: rgba(18, 15, 12, 0.79); }
.side-kicker { font-size: 11px; letter-spacing: 3px; color: rgb(200, 162, 74); margin-bottom: 17px; }
.side-rule { width: 42px; height: 2px; background-color: rgb(200, 162, 74); margin-bottom: 20px; }
.side-copy { font-size: 15px; line-height: 1.5; color: rgba(233, 220, 195, 0.84); white-space: normal; margin-bottom: 26px; }
.side-controls { font-size: 10px; letter-spacing: 1px; color: rgba(233, 220, 195, 0.62); }
.footer { width: 100%; max-width: 1420px; flex-direction: row; justify-content: space-between; align-items: center; padding-top: 12px; border-top-width: 1px; border-top-color: rgba(200, 162, 74, 0.28); }
.hint { font-size: 11px; letter-spacing: 3px; color: rgba(233, 220, 195, 0.65); }
.version { font-size: 10px; letter-spacing: 2px; color: rgba(233, 220, 195, 0.45); }
.overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(6, 4, 3, 0.86); }
.hidden { display: none; }
.overlay-card { width: 520px; padding: 38px 46px 34px 46px; background-color: rgb(22, 18, 15); border-width: 1px; border-color: rgba(200, 162, 74, 0.6); align-items: center; }
.overlay-title { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 28px; letter-spacing: 5px; color: rgb(246, 239, 223); -unity-text-align: middle-center; }
.help-row { flex-direction: row; align-items: center; width: 100%; margin-bottom: 12px; }
.key-badge { width: 76px; height: 32px; margin-right: 18px; border-width: 1px; border-color: rgba(200, 162, 74, 0.6); background-color: rgba(200, 162, 74, 0.08); color: rgb(227, 199, 122); font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; }
.help-text { flex-grow: 1; font-size: 15px; color: rgba(233, 220, 195, 0.82); white-space: normal; }
.btn-overlay { width: 240px; margin-top: 22px; margin-bottom: 0; }

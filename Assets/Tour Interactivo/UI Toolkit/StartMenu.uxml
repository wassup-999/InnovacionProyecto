<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="StartMenu.uss" />
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement name="backdrop" class="backdrop" picking-mode="Ignore" />
        <ui:VisualElement class="veil" picking-mode="Ignore" />
        <ui:VisualElement class="frame">
            <ui:VisualElement class="top-bar">
                <ui:VisualElement class="gold-square" />
                <ui:Label text="MUSEO DE LA INNOVACIÓN" class="museum-label" />
                <ui:VisualElement class="top-line" />
                <ui:Label text="VISITA GUIADA" class="room-label" />
            </ui:VisualElement>
            <ui:VisualElement class="content-row">
                <ui:VisualElement class="intro">
                    <ui:Label text="COLECCIÓN PERMANENTE" class="eyebrow" />
                    <ui:Label text="Un museo" class="title" />
                    <ui:Label text="para explorar" class="title title-accent" />
                    <ui:VisualElement class="ornament">
                        <ui:VisualElement class="ornament-line" />
                        <ui:VisualElement class="ornament-diamond" />
                        <ui:VisualElement class="ornament-line" />
                    </ui:VisualElement>
                    <ui:Label text="Recorre sus salas a tu ritmo. Acércate a las obras y esculturas para descubrir sus historias." class="subtitle" />
                    <ui:VisualElement class="actions">
                        <ui:Button name="start-button" text="COMENZAR RECORRIDO   →" class="btn btn-primary" />
                        <ui:Button name="help-button" text="CÓMO JUGAR" class="btn btn-ghost" />
                        <ui:Button name="quit-button" text="SALIR DEL MUSEO" class="btn btn-ghost" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="side-note">
                    <ui:Label text="EL ARTE COBRA VIDA" class="side-kicker" />
                    <ui:VisualElement class="side-rule" />
                    <ui:Label text="Pinturas, esculturas y visitantes te esperan. Mira a tu alrededor y sigue tu curiosidad." class="side-copy" />
                    <ui:Label text="WASD  ·  RATÓN  ·  E PARA EXAMINAR" class="side-controls" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="footer">
                <ui:Label text="INNOVACIÓN · CULTURA · HISTORIA" class="hint" />
                <ui:Label text="INNOVACIONPROYECTO  /  2026" class="version" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="help-overlay" class="overlay hidden">
            <ui:VisualElement class="overlay-card">
                <ui:Label text="CÓMO JUGAR" class="overlay-title" />
                <ui:VisualElement class="ornament ornament-small"><ui:VisualElement class="ornament-line" /><ui:VisualElement class="ornament-diamond" /><ui:VisualElement class="ornament-line" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:Label text="WASD" class="key-badge" /><ui:Label text="Caminar por la galería" class="help-text" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:Label text="RATÓN" class="key-badge" /><ui:Label text="Mirar alrededor" class="help-text" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:Label text="E" class="key-badge" /><ui:Label text="Examinar la obra o escultura señalada" class="help-text" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:Label text="ESC" class="key-badge" /><ui:Label text="Pausar el recorrido" class="help-text" /></ui:VisualElement>
                <ui:Button name="help-close-button" text="VOLVER AL MENÚ" class="btn btn-primary btn-overlay" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
